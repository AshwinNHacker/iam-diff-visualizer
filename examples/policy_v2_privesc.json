{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadOnlyAppBucket",
      "Effect": "Allow",
      "Action": "s3:Get*",
      "Resource": [
        "arn:aws:s3:::app-artifacts-bucket",
        "arn:aws:s3:::app-artifacts-bucket/*"
      ]
    },
    {
      "Sid": "S3ListAllBuckets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "*"
    },
    {
      "Sid": "LogsWrite",
      "Effect": "Allow",
      "Action": "logs:PutLogEvents",
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/app/*"
    },
    {
      "Sid": "AllowDeployAutomation",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "iam:PassRole"
      ],
      "Resource": "*"
    }
  ]
}
